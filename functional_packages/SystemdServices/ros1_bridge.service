[Unit]
Description=ROS 1 to ROS 2 Dynamic Bridge Service
After=network.target # 确保在网络就绪后启动
Wants=network.target

[Service]
Type=simple
User=fishros # 替换为你的用户名
WorkingDirectory=/home/fishros # 替换为你的home目录路径
ExecStart=/bin/bash -c "source /opt/ros/humble/setup.bash && source /path/to/your/ROS1-Ros2_Bridge/install/local_setup.bash && ros2 run ros1_bridge dynamic_bridge --bridge-all-topics"
Restart=on-failure # 如果进程意外退出，自动重启
RestartSec=5s

[Install]
WantedBy=multi-user.target